# Local emulators only: no Firebase project, keys, login, or billing required.
VITE_USE_FIREBASE_EMULATORS=true
# Optional: use this computer's current LAN address so QR links work on phones.
# VITE_PUBLIC_ORIGIN=http://192.168.1.10:5173

# For cloud deployment: set the emulator flag to false, supply your Firebase web
# app config JSON and reCAPTCHA Enterprise App Check site key, then rebuild.
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}
# VITE_FIREBASE_APPCHECK_SITE_KEY=...

# Embedded mode: exact trusted hub origins, comma-separated. Local testing only:
# VITE_BETWEEN_TURNS_ORIGINS=http://127.0.0.1:5180
# The default same-origin /embeddedApi path uses Hosting's function rewrite
# or Vite's local emulator proxy. No game credentials belong in VITE_ variables.
