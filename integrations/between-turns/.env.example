# Local development uses only emulators. Copy to .env.local.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-between-turns
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-between-turns.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
# Required for a production build:
# VITE_USE_FIREBASE_EMULATORS=false
# VITE_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key
# Only for the labeled public preview while Firebase backend deployment is blocked:
# VITE_SERVICE_PENDING=true
