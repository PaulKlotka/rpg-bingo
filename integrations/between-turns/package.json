{
  "name": "between-turns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1 --port 5180",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "build": "npm run typecheck && npm --prefix functions run build && vite build --configLoader runner",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:browser": "playwright test",
    "emulators": "npm --prefix functions run build && node scripts/emulators.mjs",
    "verify:emulators": "npm --prefix functions run build && node scripts/emulators.mjs verify",
    "firebase": "node scripts/firebase.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "google-auth-library": "^10.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
