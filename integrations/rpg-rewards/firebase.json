{
  "functions": [
    {
      "source": "functions",
      "codebase": "rewards",
      "predeploy": [
        "npm --prefix functions run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/embeddedApi",
        "function": {
          "functionId": "embeddedApi",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/embed{,/**}",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors https://between-turns-paul.web.app"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8180
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5101
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4100
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4501
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4601
    },
    "singleProjectMode": true
  }
}
