# Production backend identity: exact deployed gameApi URL (OIDC audience).
REWARDS_RUNTIME_SERVICE_ACCOUNT=rewards-runtime@YOUR_PROJECT_ID.iam.gserviceaccount.com
GAME_API_AUDIENCE=https://REGION-PROJECT.cloudfunctions.net/gameApi
# Register each trusted game's service account and exact callback URL(s).
GAME_CLIENTS_JSON={"example-game":{"serviceAccount":"game-runtime@GAME_PROJECT.iam.gserviceaccount.com","redirectUris":["https://GAME_HOST/callback"]}}
