{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "shared",
    "demo",
    "tests",
    "playwright.config.ts",
    "playwright.live.config.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "functions/node_modules"
  ]
}
