{
  "name": "rpg-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:functions && vite build --configLoader runner",
    "build:functions": "npm --prefix functions run build",
    "emulators": "npm run build:functions && node scripts/emulators.mjs",
    "test:multiplayer": "tsx --test tests/multiplayer/*.test.ts",
    "preview": "vite preview --host 0.0.0.0 --configLoader runner",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "qrcode": "^1.5.4"
  }
}
